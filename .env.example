NODE_ENV=development
APP_PORT=3000

PG_HOST=localhost
PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_DATABASE=payments
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments

REDIS_HOST=localhost
REDIS_PORT=6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=payments

MERCADO_PAGO_BASE_URL=http://localhost:8081
MERCADO_PAGO_ACCESS_TOKEN=TEST-local-token
MERCADO_PAGO_WEBHOOK_SECRET=local-webhook-secret
MERCADO_PAGO_NOTIFICATION_URL=http://host.docker.internal:3000/api/webhooks/mercado-pago
MERCADO_PAGO_TIMEOUT_MS=5000

CHECKOUT_BACK_URL=http://localhost:3000/docs
CHECKOUT_TTL_MINUTES=1440
CHECKOUT_POLL_INTERVAL_SECONDS=300
